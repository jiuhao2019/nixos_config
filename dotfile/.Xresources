! ============================================================
! Xresources — Gruvbox
! Based on gruvbox.nvim palette
! ============================================================

! ------------------------------------------------------------
! Xcursor
! ------------------------------------------------------------

Xcursor.theme: Bibata-Modern-Amber
Xcursor.size: 11

! ------------------------------------------------------------
! XTerm — General
! ------------------------------------------------------------

XTerm*termName: xterm-256color

XTerm*faceName: FiraCode Nerd Font Mono
XTerm*faceSize: 13

XTerm*saveLines: 10000
XTerm*scrollBar: false

XTerm*selectToClipboard: true
XTerm*highlightSelection: true

XTerm*metaSendsEscape: true

! 不闪烁 Bell
XTerm*bellIsUrgent: false
XTerm*visualBell: false

! 文本光标
XTerm*cursorColor: #ddc7a1
XTerm*cursorBlink: false

! 窗口内边距
XTerm*internalBorder: 8

! ------------------------------------------------------------
! Gruvbox — Base
! ------------------------------------------------------------

XTerm*background: #32302f
XTerm*foreground: #d4be98

! ------------------------------------------------------------
! ANSI 16 colors
! ------------------------------------------------------------

! Normal
XTerm*color0:  #1d2021
XTerm*color1:  #ea6962
XTerm*color2:  #a9b665
XTerm*color3:  #d8a657
XTerm*color4:  #7daea3
XTerm*color5:  #d3869b
XTerm*color6:  #89b482
XTerm*color7:  #d4be98

! Bright
XTerm*color8:  #5a524c
XTerm*color9:  #ea6962
XTerm*color10: #a9b665
XTerm*color11: #e78a4e
XTerm*color12: #7daea3
XTerm*color13: #d3869b
XTerm*color14: #89b482
XTerm*color15: #ddc7a1

! ------------------------------------------------------------
! XTerm — Selection
! ------------------------------------------------------------

XTerm*highlightColor: #45403d
XTerm*highlightTextColor: #ddc7a1

! ------------------------------------------------------------
! XTerm — URL / underline
! ------------------------------------------------------------

XTerm*underLine: true

! ------------------------------------------------------------
! XTerm — Geometry
! ------------------------------------------------------------

! 默认窗口大小
XTerm*geometry: 120x35

! ------------------------------------------------------------
! XTerm — Misc
! ------------------------------------------------------------

! 不显示菜单栏
XTerm*menuBar: false

! 禁止 Ctrl+S 导致 XOFF
XTerm*vt100*translations: #override 
Ctrl<Key>S: string(0x13) \n
Ctrl<Key>Q: string(0x11)
