! ============================================================
! Xresources — Gruvbox
! ============================================================

! ------------------------------------------------------------
! Xcursor
! ------------------------------------------------------------

Xcursor.theme: Bibata-Modern-Amber
Xcursor.size: 11

! ------------------------------------------------------------
! XTerm — General
! ------------------------------------------------------------

XTerm*termName: xterm-256color

XTerm*faceName: FiraCode Nerd Font Mono
XTerm*faceSize: 13

XTerm*saveLines: 10000
XTerm*scrollBar: false

XTerm*selectToClipboard: true
XTerm*highlightSelection: true

XTerm*metaSendsEscape: true

! 不闪烁 Bell
XTerm*bellIsUrgent: false
XTerm*visualBell: false

! 文本光标
XTerm*cursorColor: #ebdbb2
XTerm*cursorBlink: false

! 窗口内边距
XTerm*internalBorder: 8


! ------------------------------------------------------------
! Gruvbox — Base
! ------------------------------------------------------------

XTerm*background: #282828
XTerm*foreground: #ebdbb2

XTerm*color0:  #282828
XTerm*color1:  #cc241d
XTerm*color2:  #98971a
XTerm*color3:  #d79921
XTerm*color4:  #458588
XTerm*color5:  #b16286
XTerm*color6:  #689d6a
XTerm*color7:  #a89984

XTerm*color8:  #928374
XTerm*color9:  #fb4934
XTerm*color10: #b8bb26
XTerm*color11: #fabd2f
XTerm*color12: #83a598
XTerm*color13: #d3869b
XTerm*color14: #8ec07c
XTerm*color15: #ebdbb2


! ------------------------------------------------------------
! XTerm — Selection
! ------------------------------------------------------------

XTerm*highlightColor: #504945
XTerm*highlightTextColor: #ebdbb2


! ------------------------------------------------------------
! XTerm — URL / underline
! ------------------------------------------------------------

XTerm*underLine: true


! ------------------------------------------------------------
! XTerm — Geometry
! ------------------------------------------------------------

! 默认窗口大小
XTerm*geometry: 120x35


! ------------------------------------------------------------
! XTerm — Misc
! ------------------------------------------------------------

! 不显示菜单栏
XTerm*menuBar: false

! 禁止 Ctrl+S 导致 XOFF
XTerm*vt100*translations: #override \
    Ctrl<Key>S: string(0x13) \n\
    Ctrl<Key>Q: string(0x11)
